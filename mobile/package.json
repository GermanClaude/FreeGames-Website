{
  "name": "nullpunkt-android",
  "productName": "NULLPUNKT",
  "version": "1.0.0",
  "private": true,
  "description": "NULLPUNKT als Android-App (Capacitor-Hülle um die Webseite, gleiche Spielfassung wie online)",
